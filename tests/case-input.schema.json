{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://celecolabs.com/assessment/data/case-input.schema.json",
  "title": "Northstar service request",
  "type": "object",
  "additionalProperties": true,
  "required": ["requestId", "receivedAt", "channel", "sender", "subject", "body", "attachments"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "receivedAt": { "type": "string", "format": "date-time" },
    "channel": { "enum": ["email", "portal"] },
    "sender": {
      "type": "object",
      "required": ["name", "email"],
      "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" } }
    },
    "subject": { "type": "string" },
    "body": { "type": "string" },
    "attachments": { "type": "array", "items": { "type": "object" } }
  }
}

