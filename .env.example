# Copy to .env and fill in. .env is gitignored and excluded from the Docker image.
# Northstar business APIs (does NOT authenticate to the model gateway)
NORTHSTAR_ACCESS_TOKEN=
# Celeco model gateway
CELECO_MODEL_GATEWAY_KEY=

# --- optional, sensible defaults shown -------------------------------------
# These two bound how long a case can spend waiting on Northstar. A safety case
# must never wait behind a slow dependency (POL-SAFETY-001), and the provided
# runner allows 120s for a whole case.

# Per-request timeout for Northstar business reads. Deliberately separate from
# the model call, which legitimately takes longer.
NORTHSTAR_TIMEOUT_SECONDS=5

# Wall-clock ceiling for gathering all the evidence for one case. Anything not
# back by then counts as a failed lookup and the case is decided on what did
# arrive, so a hazard still escalates immediately.
EVIDENCE_BUDGET_SECONDS=15
